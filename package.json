{
  "name": "letant",
  "version": "0.0.3",
  "description": "AST based language-agnostic structural code comprehension",
  "keywords": [],
  "author": "Juun",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juunie-roh/letant.git"
  },
  "homepage": "https://github.com/juunie-roh/letant#readme",
  "bugs": {
    "url": "https://github.com/juunie-roh/letant/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/config/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/config/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/utils/query/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/utils/query/index.js"
      }
    }
  },
  "scripts": {
    "attw": "attw --pack --ignore-rules 'no-resolution'",
    "attw:quiet": "attw --pack --quiet --ignore-rules 'no-resolution'",
    "attw:all": "pnpm attw:quiet && pnpm -r attw:quiet",
    "build": "tsup",
    "build:all": "pnpm build && pnpm -r build",
    "check-types": "tsc -p ./tsconfig.json --noEmit",
    "check-types:all": "tsc -p ./tsconfig.json --noEmit && pnpm -r check-types",
    "dev": "tsup --watch",
    "dev:config": "LOG_LEVEL=debug node packages/cli/dist/letant.js --config packages/cli/__mocks__/letant.config.json",
    "lint": "eslint . --cache",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "js": "pnpm --filter @letant/js",
    "cli": "pnpm --filter @letant/cli"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@commitlint/format": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
