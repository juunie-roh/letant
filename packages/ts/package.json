{
  "name": "@letant/ts",
  "version": "0.0.3",
  "description": "TypeScript plugin for letant",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "attw": "attw --pack --ignore-rules 'no-resolution'",
    "attw:quiet": "attw --pack --quiet --ignore-rules 'no-resolution'",
    "build": "tsup",
    "check-types": "tsc -p ./tsconfig.json --noEmit",
    "dev": "tsup --watch",
    "dev:query": "node ../cli/dist/letant.js query --grammar tree-sitter-typescript"
  },
  "keywords": [],
  "author": "Juun",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "letant": "^0.0.3",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "letant": "^0.0.3",
    "tree-sitter-typescript": "^0.23.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
